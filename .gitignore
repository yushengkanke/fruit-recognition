app.db
*.db.bak-*
*.db-journal
*.db-wal
*.db-shm

# 未配置 AUTH_SECRET 时自动生成的登录 token 签名密钥
.auth_secret

# 本次排查使用的临时验证目录
.verify-*/
.fruit-tests-*/
.run-smoke-*/
