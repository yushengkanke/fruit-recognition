# ============================================================
# 水果识别项目 · Git 忽略规则
# 原则：仓库只保留“运行 / 构建 / 部署需要的源码与配置”。
#       数据、权重、训练产物、IDE 配置、文档报告一律不上传。
#       总报告单独提交，不放进本仓库。
# ============================================================

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.code-workspace

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
env/
ENV/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# ---------- 环境变量 / 密钥 ----------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# ---------- 数据集 / 模型权重 / 训练产物 ----------
# 这些体积大、可由训练或单独上传获得，绝不进 Git
dataset_fruits_detection-main/
data/
models/
weights/
outputs/
*.pth
*.onnx
*.engine
*.h5
*.keras
*.pkl
*.joblib
*.npy
*.npz
*.db
*.sqlite
*.sqlite3
*.csv
*.cache
runs/*
!runs/detect/
!runs/detect/TSv1-3/
!runs/detect/TSv1-3/weights/
!runs/detect/TSv1-3/weights/best.pt


# ---------- 日志 / 临时文件 / 压缩包 ----------
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*~
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ---------- 文档 / 报告 / 演示材料 ----------
