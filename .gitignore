*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
!test1.jpg
!test2.jpg
!test3.jpg

# ---------- 其他生成物 ----------
/answer.txt

# ---------- 本次任务产生的运行时 / 临时文件 ----------
